[Unit]
Description=%DESCRIPTION%
After=network.target
Wants=network.target

[Service]
Type=simple
# The user the service should run as (will be set by installer)
User=%USER%
# The working directory of your Next.js project
WorkingDirectory=%WORKING_DIR%
# Environment
Environment=NODE_ENV=production
Environment=PORT=%PORT%
# Optionally ensure Node/npm are on PATH if not globally available
# Adjust PATH below if needed, or leave blank to inherit
Environment=PATH=%PATH%
# Start command (uses npm so it picks up scripts from package.json)
ExecStart=%EXECSTART%
Restart=always
RestartSec=10
# Log to journald with a fixed identifier
StandardOutput=journal
StandardError=journal
SyslogIdentifier=%SERVICE_NAME%

[Install]
WantedBy=multi-user.target
